# Backend Environment Configuration Example
# Copy to .env for local development or set in Render Environment Variables

# Environment label: local | dev | production
ENVIRONMENT=local

# Server Port (Render sets this automatically via $PORT)
PORT=8000

# Allowed CORS origins (comma-separated or * for all)
# Example for production: https://your-project.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=*
